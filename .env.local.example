# Copie para .env.local na raiz do repo (gitignored).
# serve.ps1 carrega este arquivo automaticamente.

# Diretório de dados (opcional; padrão: %LOCALAPPDATA%\ai-memory)
# AI_MEMORY_DATA_DIR=C:\Users\pedro.ailton\AppData\Local\ai-memory

# --- Modo zero-LLM: deixe tudo abaixo comentado ---

# Provider: anthropic | openai | openai-compat | cursor
# AI_MEMORY_LLM_PROVIDER=cursor

# Cursor SDK (local Composer — mesmo pool do IDE; fork)
# Requer: cd scripts/cursor-bridge && npm install
# AI_MEMORY_LLM_PROVIDER=cursor
# CURSOR_API_KEY=
# CURSOR_MODEL=composer-2.5
# CURSOR_MODEL_FAST=false
# CURSOR_AGENT_CWD=C:\GIT\consisanet
# CURSOR_TIMEOUT_MS=120000

# LLM (consolidação de sessões, bootstrap)
# AI_MEMORY_LLM_PROVIDER=anthropic
# AI_MEMORY_LLM_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# Ou OpenAI-compat (Cursor / OpenRouter / Ollama)
# AI_MEMORY_LLM_PROVIDER=openai-compat
# AI_MEMORY_LLM_BASE_URL=https://openrouter.ai/api/v1
# AI_MEMORY_LLM_MODEL=anthropic/claude-haiku-4.5
# LLM_API_KEY=sk-or-v1-...

# Embeddings (busca híbrida; opcional)
# OpenRouter usa o mesmo cliente OpenAI-compat que o LLM openai-compat.
# Chave: OPENAI_API_KEY ou LLM_API_KEY (reutiliza a do OpenRouter).
# AI_MEMORY_EMBEDDING_PROVIDER=openai
# AI_MEMORY_EMBEDDING_MODEL=openai/text-embedding-3-small
# AI_MEMORY_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# OPENAI_API_KEY=sk-...   # alternativa se não usar OpenRouter para LLM
# AI_MEMORY_EMBEDDING_DIM=1536
# AI_MEMORY_EMBEDDING_MAX_BYTES=8000   # default; raise for 32k models (e.g. 32000)

# Embeddings direto na OpenAI (sem OpenRouter)
# AI_MEMORY_EMBEDDING_PROVIDER=openai
# AI_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# AI_MEMORY_EMBEDDING_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...

# Google Gemini embeddings (https://ai.google.dev/gemini-api/docs/embeddings)
# AI_MEMORY_EMBEDDING_PROVIDER=google
# AI_MEMORY_EMBEDDING_MODEL=gemini-embedding-001
# AI_MEMORY_EMBEDDING_DIM=768
# GEMINI_API_KEY=
# GOOGLE_API_KEY=   # alias aceito

# Auth (só se expor além de loopback)
# AI_MEMORY_AUTH_TOKEN=
